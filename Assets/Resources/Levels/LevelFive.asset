  lessons:
  - text: "Bugs are normal! Look for missing colons, quotes, indentation, and typos."
    code: "if x > 3: # colon\n    print(x) # spelling"
  - text: "Python names common error types. Learn to recognize them."
    code: "TypeError  NameError\nValueError IndexError\nSyntaxError"
  - text: "Read the line, find what breaks the rules, then fix it."
    code: "# Check syntax, spelling, and values"
  buildChallenges: []
  questions:
  - tag: "DEBUG"
    prompt: "What does print(2 + 3) display?"
    code: "print(2 + 3)"
    answer: "5"
    explanation: "The + operator adds integers."
    wrong:
    - "23"
    - "2 + 3"
    - "6"
  - tag: "DEBUG"
    prompt: "Which operator means not equal to?"
    code: "if status __ \"ready\":"
    answer: "!="
    explanation: "!= tests whether values differ."
    wrong:
    - "="
    - "=="
    - "!"
  - tag: "DEBUG"
    prompt: "What does this print?"
    code: "power = 100\nprint(power)"
    answer: "100"
    explanation: "print(power) displays its stored value."
    wrong:
    - "power"
    - "0"
    - "True"
  bossQuestions:
