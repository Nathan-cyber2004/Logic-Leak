  lessons:
  - text: "A for loop repeats code. range(n) counts from 0 up to n-1."
    code: "for i in range(3):\n    print(i) # 0 1 2"
  - text: "range(start, stop, step) can skip numbers. The stop value is not included."
    code: "range(2, 9, 2) # 2, 4, 6, 8"
  - text: "A while loop repeats until its condition is False. Make sure something changes!"
    code: "x = 0\nwhile x < 3:\n    x += 1"
  buildChallenges: []
  questions:
  - tag: "LOOPS"
    prompt: "How many times does this loop run?"
    code: "for i in range(5):\n    hit()"
    answer: "5"
    explanation: "range(5) produces 0 through 4."
    wrong:
    - "4"
    - "6"
    - "1"
  - tag: "LOOPS"
    prompt: "What is the last value of i?"
    code: "for i in range(10):\n    pass"
    answer: "9"
    explanation: "range stops before 10."
    wrong:
    - "10"
    - "8"
    - "0"
  - tag: "LOOPS"
    prompt: "What must end a Python for-loop header?"
    code: "for i in range(3)__"
    answer: ":"
    explanation: "Python uses a colon before the loop body."
    wrong:
    - ";"
    - ")"
    - "."
  bossQuestions:
  - tag: "LOOPS"
    prompt: "How many times does this loop run?"
    code: "for i in range(5):\n    hit()"
    answer: "5"
    explanation: "range(5) produces 0 through 4."
    wrong:
    - "4"
    - "6"
    - "1"
  - tag: "LOOPS"
    prompt: "What is the last value of i?"
    code: "for i in range(10):\n    pass"
    answer: "9"
    explanation: "range stops before 10."
    wrong:
    - "10"
    - "8"
    - "0"
  - tag: "LOOPS"
    prompt: "What must end a Python for-loop header?"
