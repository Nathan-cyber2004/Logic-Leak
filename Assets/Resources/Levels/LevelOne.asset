  bossQuestionTime: 10
  lessons:
  - text: "Variables store values. The name goes on the left, the value on the right."
    code: "hp = 100\nname = \"Neo\"\nalive = True"
  - text: "Values have types: int for whole numbers, float for decimals, str for text, and bool for True or False."
    code: "type(5)       # int\ntype(\"5\")     # str"
  - text: "The + operator adds numbers and joins strings."
    code: "1 + 2         # 3\n\"a\" + \"b\"     # ab"
  buildChallenges: []
  questions:
  - tag: "PREDICT"
    prompt: "What does this print?"
    code: "a = 4\nb = 3\nprint(a + b)"
    answer: "7"
    explanation: "+ adds two numbers."
    wrong:
    - "12"
    - "8"
    - "1"
  - tag: "PREDICT"
    prompt: "What does this print?"
    code: "s = \"neo\"\nprint(s + \"leak\")"
    answer: "neoleak"
    explanation: "+ joins strings without adding a space."
    wrong:
    - "neo leak"
    - "leakneo"
    - "neo+leak"
  - tag: "TYPE CHECK"
    prompt: "What type is x?"
    code: "x = \"42\"\nprint(type(x))"
    answer: "str"
    explanation: "Text inside quotes has type str."
    wrong:
    - "int"
    - "float"
    - "bool"
  bossQuestions:
