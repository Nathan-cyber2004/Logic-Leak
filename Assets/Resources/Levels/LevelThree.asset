  lessons:
  - text: "A list stores many values in order."
    code: "items = [\"bolt\", \"chip\", \"wire\"]"
  - text: "Indexes start at 0. Negative indexes count from the end."
    code: "items = [\"bolt\", \"chip\", \"wire\"]\nitems[0]  # bolt\nitems[-1] # wire"
  - text: "append adds an item to the end. len counts items and pop removes the last item."
    code: "items.append(\"gear\")\nlen(items) # item count\nitems.pop()"
  buildChallenges: []
  questions:
  - tag: "LISTS"
    prompt: "What does inventory[0] access?"
    code: "inventory = [\"battery\", \"chip\"]\nprint(inventory[0])"
    answer: "battery"
    explanation: "Lists start counting at index 0."
    wrong:
    - "chip"
    - "0"
    - "2"
  - tag: "LISTS"
    prompt: "How many items are in this list?"
    code: "parts = [\"wire\", \"chip\", \"gear\"]\nprint(len(parts))"
    answer: "3"
    explanation: "len returns the number of items."
    wrong:
    - "2"
    - "4"
    - "0"
  - tag: "LISTS"
    prompt: "Which method adds an item to the end of a list?"
    code: "inventory = [\"battery\"]\ninventory.____(\"chip\")"
    answer: "append"
    explanation: "append(value) adds a value at the end."
    wrong:
    - "add"
    - "insertEnd"
    - "push"
  bossQuestions:
