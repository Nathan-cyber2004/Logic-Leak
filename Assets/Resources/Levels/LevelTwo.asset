  lessons:
  - text: "if runs code only when a condition is True. Do not forget the colon!"
    code: "if hp < 20:\n    print(\"Heal!\")"
  - text: "Use == to compare values. A single = assigns a value."
    code: "x == 5   # compare\nx = 5    # assign"
  - text: "elif adds another check, else handles the rest."
    code: "if x < 10:\n    ...\nelif x < 20:\n    ...\nelse:\n    ..."
  buildChallenges: []
  questions:
  - tag: "CONDITIONS"
    prompt: "Which operator checks whether values are equal?"
    code: "if power __ 5:\n    open_gate()"
    answer: "=="
    explanation: "Use == to compare; = assigns."
    wrong:
    - "="
    - "!="
    - ">"
  - tag: "CONDITIONS"
    prompt: "What type are True and False?"
    code: "powered = True\nlocked = False"
    answer: "bool"
    explanation: "Boolean values represent True or False."
    wrong:
    - "str"
    - "int"
    - "float"
  - tag: "CONDITIONS"
    prompt: "Which branch runs when the if condition is false?"
    code: "if power > 50:\n    open_gate()\n__:\n    recharge()"
    answer: "else"
    explanation: "else handles the false case."
    wrong:
    - "elif"
    - "then"
    - "for"
  bossQuestions:
  - tag: "CONDITIONS"
    prompt: "Which operator checks whether values are equal?"
    code: "if power __ 5:\n    open_gate()"
    answer: "=="
    explanation: "Use == to compare; = assigns."
    wrong:
    - "="
